APP_ENV=production
APP_ADDR=:8080
APP_PUBLIC_PORT=8080
APP_WEB_DIR=/app/web/dist
APP_ASSET_DIR=/app/data/assets
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_SESSION_SECURE=false
APP_SESSION_TTL=12h
APP_LOGIN_MAX_ATTEMPTS=10
APP_LOGIN_WINDOW=10m
APP_MAX_DOWNLOAD_BYTES=1073741824

DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
DATABASE_NAME=manga_drama_studio
DATABASE_USER=manga_studio
DATABASE_PASSWORD=replace-with-your-baota-mysql-password
DATABASE_PARAMS=charset=utf8mb4&parseTime=true&loc=UTC

NEW_API_BASE_URL=http://host.docker.internal:3000
NEW_API_TOKEN=replace-with-a-new-newapi-token
SCRIPT_MODEL=deepseek-v4-pro
VIDEO_FAST_MODEL=doubao-seedance-2-0-fast-260128
VIDEO_QUALITY_MODEL=doubao-seedance-2-0-260128
VIDEO_DEFAULT_MODEL=doubao-seedance-2-0-fast-260128
VIDEO_MAX_CONCURRENCY=2
VIDEO_POLL_INTERVAL=5s
VIDEO_TASK_TIMEOUT=30m

GOPROXY=https://goproxy.cn,direct
